package com.tpedro.mqtt;

import org.eclipse.paho.client.mqttv3.MqttClient;
import org.eclipse.paho.client.mqttv3.MqttMessage;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Random;

public class MqttSensorSimulator {
    
    public static void main(String[] args) {
        String broker = "tcp://broker.hivemq.com:1883";
        String deviceId = "sensor_sala_101"; 
        String topic = "uevora/metrics";

        try {
            MqttClient client = new MqttClient(broker, deviceId);
            client.connect();
            Random random = new Random();

            // Valores iniciais para simular variação gradual (Requisito 3.1.5)
            double currentTemp = 20.0; 
            double currentHum = 50.0;

            System.out.println("Simulador MQTT iniciado para o dispositivo: " + deviceId);

            while (true) {
                // Variação gradual (-0.5 a +0.5)
                currentTemp += (random.nextDouble() - 0.5);
                currentHum += (random.nextDouble() - 0.5);

                // Valores dentro dos intervalos (15-30ºC e 30-80%)
                currentTemp = Math.max(15, Math.min(30, currentTemp));
                currentHum = Math.max(30, Math.min(80, currentHum));

                // JSON exatamente MetricDTO
                String timestamp = LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME);
                String jsonPayload = String.format(
                    "{\"id\":\"%s\", \"temperatura\":%.2f, \"humidade\":%.2f, \"timestamp\":\"%s\"}",
                    deviceId, currentTemp, currentHum, timestamp
                );

                // Publicar JSON
                MqttMessage message = new MqttMessage(jsonPayload.getBytes());
                message.setQos(1);
                client.publish(topic, message);

                System.out.println("Enviado: " + jsonPayload);

                // Esperar 5 segundos antes da próxima leitura
                Thread.sleep(5000);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}